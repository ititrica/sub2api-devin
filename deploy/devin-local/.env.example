# Copy to .env and replace every placeholder before deployment.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_UNIQUE_PASSWORD
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
REDIS_PASSWORD=REPLACE_WITH_A_RANDOM_REDIS_PASSWORD
# Use 64 hexadecimal characters for each of these keys.
JWT_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS
TOTP_ENCRYPTION_KEY=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

# Optional: only needed for these Google OAuth providers, not Devin.
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
GEMINI_CLI_OAUTH_CLIENT_ID=
GEMINI_CLI_OAUTH_CLIENT_SECRET=
